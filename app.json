{
  "expo": {
    "name": "SplitWiser",
    "slug": "splitwiser",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.splitwiser.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14B87A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.splitwiser.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#13B079",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#13B079"
          }
        }
      ],
      "./plugins/with-local-network",
      [
        "expo-image-picker",
        {
          "photosPermission": "SplitWiser uses your photos to set your profile picture.",
          "cameraPermission": "SplitWiser uses the camera for your profile picture and to scan friends’ QR codes."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SplitWiser uses the camera to scan friends’ QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "SplitWiser checks which of your contacts are on SplitWiser so you can add them."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SplitWiser uses Face ID to lock the app."
        }
      ]
    ],
    "scheme": "splitwiser",
    "experiments": {
      "typedRoutes": true
    }
  }
}
